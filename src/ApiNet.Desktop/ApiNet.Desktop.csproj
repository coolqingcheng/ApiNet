<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>../ApiNet.UI/Assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/WindowsShell*.cs" Link="Services/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../ApiNet.UI/Assets/app.ico" LogicalName="ApiNet.ShellIcon.ico" />
    <InternalsVisibleTo Include="ApiNet.Desktop.Tests" />
    <ProjectReference Include="../ApiNet.UI/ApiNet.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.4.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ApiNet.Core/ApiNet.Core.csproj" />
    <ProjectReference Include="../ApiNet.Infrastructure/ApiNet.Infrastructure.csproj" />
    <ProjectReference Include="../ApiNet.Proxy/ApiNet.Proxy.csproj" />
  </ItemGroup>
</Project>
