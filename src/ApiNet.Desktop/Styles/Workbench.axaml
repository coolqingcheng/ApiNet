<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window"><Setter Property="FontFamily" Value="Inter, Microsoft YaHei UI, Noto Sans CJK SC, sans-serif" /><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="#E4E6ED" /></Style>
  <Style Selector="TextBox"><Setter Property="CornerRadius" Value="5" /><Setter Property="Background" Value="#191B21" /><Setter Property="BorderBrush" Value="#383B46" /><Setter Property="Padding" Value="10,8" /><Setter Property="SelectionBrush" Value="#655142" /></Style>
  <Style Selector="TextBox.editor"><Setter Property="FontFamily" Value="Cascadia Code, Consolas, Menlo, monospace" /><Setter Property="FontSize" Value="13" /><Setter Property="Background" Value="#1D1F26" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="16" /><Setter Property="TextWrapping" Value="NoWrap" /><Setter Property="AcceptsReturn" Value="True" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" /><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" /></Style>
  <Style Selector="Button"><Setter Property="CornerRadius" Value="5" /><Setter Property="Background" Value="#2C2F38" /><Setter Property="Padding" Value="12,8" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Cursor" Value="Hand" /></Style>
  <Style Selector="Button.primary"><Setter Property="Background" Value="#F48655" /><Setter Property="Foreground" Value="#18191E" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#FF9F74" /></Style>
  <Style Selector="Button.ghost"><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="8,6" /><Setter Property="Foreground" Value="#A9ADBB" /></Style>
  <Style Selector="Button.rail"><Setter Property="Background" Value="Transparent" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="Padding" Value="4,14" /><Setter Property="Foreground" Value="#8E94A5" /></Style>
  <Style Selector="Button.rail.active"><Setter Property="Background" Value="#2C2727" /><Setter Property="Foreground" Value="#FFAA83" /></Style>
  <Style Selector="ComboBox"><Setter Property="Background" Value="#24262E" /><Setter Property="BorderBrush" Value="#383B46" /><Setter Property="CornerRadius" Value="5" /><Setter Property="Padding" Value="10,8" /></Style>
  <Style Selector="TabControl"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="TabItem"><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="14,10" /></Style>
  <Style Selector="ListBoxItem"><Setter Property="Padding" Value="8,9" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
  <Style Selector="TreeViewItem"><Setter Property="Padding" Value="4,7" /></Style>
  <Style Selector="ToolTip"><Setter Property="MaxWidth" Value="480" /></Style>
</Styles>
