<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ApiNet.Desktop.ViewModels.Settings" xmlns:m="using:ApiNet.Core.Models"
        x:Class="ApiNet.Desktop.Views.Settings.EnvironmentWindow" x:DataType="vm:EnvironmentEditorViewModel"
        Title="环境变量" Width="850" Height="600" MinWidth="700" MinHeight="440" WindowStartupLocation="CenterOwner" Background="#202127">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="24">
    <StackPanel Spacing="7"><TextBlock Text="环境变量" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="在 URL、Header 和请求体中使用 {{变量名}}。当前环境会覆盖同名公共变量。" Foreground="#9499AA" /></StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,22,0,12">
      <ComboBox ItemsSource="{Binding Environments}" SelectedItem="{Binding SelectedEnvironment}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="m:EnvironmentDefinition"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <Button Grid.Column="1" Margin="8,0,0,0" Content="新建环境" Command="{Binding AddEnvironmentCommand}" />
      <Button Grid.Column="2" Margin="8,0,0,0" Content="复制" Command="{Binding DuplicateEnvironmentCommand}" />
      <Button Grid.Column="3" Margin="8,0,0,0" Content="删除环境" Command="{Binding RemoveEnvironmentCommand}" />
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,12"><TextBlock Text="环境名称" VerticalAlignment="Center" Margin="0,0,12,0" /><TextBox Grid.Column="1" Text="{Binding EnvironmentName}" /><Button Grid.Column="2" Content="＋ 变量" Margin="8,0,0,0" Command="{Binding AddVariableCommand}" /><Button Grid.Column="3" Content="删除变量" Margin="8,0,0,0" Command="{Binding RemoveVariableCommand}" /></Grid>
    <Grid Grid.Row="3" RowDefinitions="Auto,*"><Grid ColumnDefinitions="2*,3*,70" Margin="14,0,14,8"><TextBlock Text="变量名" Foreground="#9499AA" /><TextBlock Grid.Column="1" Text="值" Foreground="#9499AA" /><TextBlock Grid.Column="2" Text="敏感" Foreground="#9499AA" /></Grid>
      <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" Background="#191A1F" BorderThickness="0" Padding="4">
        <ListBox.ItemTemplate><DataTemplate x:DataType="vm:VariableRowViewModel"><Grid ColumnDefinitions="2*,3*,70" ColumnSpacing="8"><TextBox Text="{Binding Key}" Watermark="baseUrl" /><TextBox Grid.Column="1" Text="{Binding Value}" PasswordChar="{Binding PasswordCharacter}" Watermark="https://api.example.com" /><CheckBox Grid.Column="2" IsChecked="{Binding IsSecret}" HorizontalAlignment="Center" /></Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
    </Grid>
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,18,0,0"><TextBlock Text="{Binding Error}" Foreground="#F18B96" TextWrapping="Wrap" /><Button Grid.Column="1" Classes="primary" Content="保存环境" Command="{Binding SaveCommand}" /></Grid>
  </Grid>
</Window>
