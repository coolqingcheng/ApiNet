<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ApiNet.Desktop.ViewModels.Tabs" xmlns:m="using:ApiNet.Core.Models"
             xmlns:c="using:ApiNet.Desktop.Controls" x:Class="ApiNet.Desktop.Views.Tabs.WebSocketView" x:DataType="vm:WebSocketTabViewModel">
  <Grid RowDefinitions="Auto,Auto,*,5,Auto,130,Auto" Margin="16,0,16,10">
    <Expander Header="握手 Headers 与子协议" Margin="0,0,0,8"><StackPanel Spacing="8"><c:ParameterTable Rows="{Binding HeaderRows}" AddCommand="{Binding AddHeaderCommand}" Height="150" /><c:CodeEditor Text="{Binding Subprotocol}" SingleLine="True" /></StackPanel></Expander>
    <Border Grid.Row="1" Background="{DynamicResource RaisedBackgroundBrush}" Padding="10"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="双向消息" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{DynamicResource PurpleBrush}" /></Grid></Border>
    <ListBox Grid.Row="2" ItemsSource="{Binding Messages}" Background="{DynamicResource RaisedBackgroundBrush}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate x:DataType="m:SocketMessage"><StackPanel Spacing="5"><Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12"><TextBlock Text="{Binding Direction}" Foreground="{DynamicResource PurpleBrush}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" /><TextBlock Grid.Column="2" Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss.fff}}" HorizontalAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" /></Grid><SelectableTextBlock Text="{Binding Content}" FontFamily="Cascadia Code, Consolas, Menlo, monospace" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    <GridSplitter Grid.Row="3" ResizeDirection="Rows" Background="{DynamicResource SubtleBorderBrush}" />
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,8"><TextBlock Text="发送消息" VerticalAlignment="Center" /><CheckBox Grid.Column="1" Content="二进制（Base64）" IsChecked="{Binding Binary}" /></Grid>
    <c:CodeEditor Grid.Row="5" Text="{Binding Body}" Language="JSON" />
    <Button Grid.Row="6" Content="发送消息 ↗" Classes="primary" HorizontalAlignment="Right" Margin="0,10,0,0" Command="{Binding SendMessageCommand}" />
  </Grid>
</UserControl>
