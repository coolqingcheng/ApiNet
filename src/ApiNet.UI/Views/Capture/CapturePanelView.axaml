<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ApiNet.Desktop.ViewModels" xmlns:m="using:ApiNet.Core.Models"
             x:Class="ApiNet.Desktop.Views.Capture.CapturePanelView" x:DataType="vm:MainWindowViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
    <Grid ColumnDefinitions="*,Auto" Margin="10,6,8,4"><TextBlock Text="代理抓包" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Grid.Column="1" Content="清空" Classes="ghost" Command="{Binding ClearCapturesCommand}" /></Grid>
    <StackPanel Grid.Row="1" Spacing="6" Margin="10,0,10,8"><TextBlock Text="{Binding ProxyText}" Foreground="{DynamicResource SuccessBrush}" /><Button Content="启动 / 停止代理" Command="{Binding ToggleProxyCommand}" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" /><TextBlock Text="将客户端 HTTP / HTTPS 代理指向本地监听地址。" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" /></StackPanel>
    <TextBox Grid.Row="2" Text="{Binding CaptureSearch}" Watermark="筛选域名、路径、方法或状态" Margin="10,0,10,6" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="6,0,6,6"><Button Content="导出 HTTPS CA" Classes="ghost" Command="{Binding ExportCertificateCommand}" /><Button Content="代理设置" Classes="ghost" Command="{Binding SettingsCommand}" /></StackPanel>
    <ListBox Grid.Row="4" ItemsSource="{Binding Captures}" SelectedItem="{Binding SelectedCapture}" Background="Transparent" BorderThickness="0" DoubleTapped="OnOpen">
      <ListBox.ItemTemplate><DataTemplate x:DataType="m:CaptureRecord"><StackPanel Spacing="3"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"><TextBlock Text="{Binding Method}" Foreground="{DynamicResource WarningBrush}" FontSize="10" FontWeight="Bold" /><TextBlock Grid.Column="1" Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" /><TextBlock Grid.Column="2" Text="{Binding Response.StatusCode}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" /></Grid><TextBlock Text="{Binding Url}" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Response.StatusText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Button Grid.Row="5" Content="查看 / 转为调试请求" Command="{Binding ReplayCaptureCommand}" Margin="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
  </Grid>
</UserControl>
