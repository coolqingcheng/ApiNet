<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ApiNet.Desktop.Views.Mobile.MobileDialogHost" IsVisible="False">
  <Border Background="#99000000" Padding="12"><Border Background="{DynamicResource SurfaceBackgroundBrush}" CornerRadius="10" Padding="18" MaxWidth="640" VerticalAlignment="Center"><Grid RowDefinitions="Auto,*"><Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12"><TextBlock x:Name="DialogTitle" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" /><Button Grid.Column="1" Content="×" Click="Cancel" Classes="ghost" /></Grid><ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><ContentControl x:Name="DialogBody" /></ScrollViewer></Grid></Border></Border>
</UserControl>
