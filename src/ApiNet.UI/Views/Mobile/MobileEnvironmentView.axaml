<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ApiNet.Desktop.ViewModels.Settings" xmlns:m="using:ApiNet.Core.Models" x:Class="ApiNet.Desktop.Views.Mobile.MobileEnvironmentView" x:DataType="vm:EnvironmentEditorViewModel">
  <StackPanel Spacing="12"><ComboBox ItemsSource="{Binding Environments}" SelectedItem="{Binding SelectedEnvironment}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="m:EnvironmentDefinition"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBox Text="{Binding EnvironmentName}" Watermark="环境名称" /><WrapPanel><Button Content="新建环境" Command="{Binding AddEnvironmentCommand}" Margin="0,0,6,6" /><Button Content="复制" Command="{Binding DuplicateEnvironmentCommand}" Margin="0,0,6,6" /><Button Content="删除环境" Command="{Binding RemoveEnvironmentCommand}" /></WrapPanel><ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" MaxHeight="280" Background="Transparent"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:VariableRowViewModel"><StackPanel Spacing="6"><TextBox Text="{Binding Key}" Watermark="变量名 KEY" /><TextBox Text="{Binding Value}" PasswordChar="{Binding PasswordCharacter}" Watermark="值 VALUE" /><CheckBox IsChecked="{Binding IsSecret}" Content="敏感变量" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><WrapPanel><Button Content="＋ 变量" Command="{Binding AddVariableCommand}" Margin="0,0,8,0" /><Button Content="删除选中变量" Command="{Binding RemoveVariableCommand}" /></WrapPanel><TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" /><Button Content="保存环境" Classes="primary" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" /></StackPanel>
</UserControl>
