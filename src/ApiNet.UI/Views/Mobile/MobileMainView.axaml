<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ApiNet.Desktop.ViewModels.Mobile" xmlns:tabs="using:ApiNet.Desktop.ViewModels.Tabs" xmlns:m="using:ApiNet.Core.Models" xmlns:workspace="using:ApiNet.Desktop.Views.Workspace" xmlns:history="using:ApiNet.Desktop.Views.History" xmlns:capture="using:ApiNet.Desktop.Views.Capture" xmlns:tools="using:ApiNet.Desktop.Views.Tools" xmlns:mobile="using:ApiNet.Desktop.Views.Mobile"
             x:Class="ApiNet.Desktop.Views.Mobile.MobileMainView" x:DataType="vm:MobileShellViewModel" TopLevel.AutoSafeAreaPadding="True" TopLevel.SystemBarColor="{DynamicResource WindowBackgroundBrush}" Background="{DynamicResource WindowBackgroundBrush}">
  <UserControl.Styles>
    <Style Selector="Button"><Setter Property="MinHeight" Value="44" /><Setter Property="MinWidth" Value="44" /></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="44" /></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="44" /></Style>
  </UserControl.Styles>
  <Panel>
    <Grid RowDefinitions="Auto,*,Auto">
      <Border Background="{DynamicResource HeaderBackgroundBrush}" Padding="8,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto"><Button Content="☰" Classes="ghost" Command="{Binding ToggleDrawerCommand}" ToolTip.Tip="打开导航" /><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0"><TextBlock Text="API.NET" FontSize="17" FontWeight="Bold" /><TextBlock Text="{Binding Main.ApplicationVersion}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" /></StackPanel><Button Grid.Column="2" Classes="ghost" Content="◐" Command="{Binding Main.ToggleThemeCommand}" /><Button Grid.Column="3" Classes="ghost" Content="＋"><Button.Flyout><MenuFlyout><MenuItem Header="新建 HTTP 请求" Command="{Binding NewHttpCommand}" /><MenuItem Header="新建 WebSocket" Command="{Binding NewSocketCommand}" /><MenuItem Header="新建文件夹" Command="{Binding Main.NewFolderCommand}" /></MenuFlyout></Button.Flyout></Button></Grid>
      </Border>
      <Panel Grid.Row="1">
        <Grid Margin="{Binding ContentMargin}">
          <Grid IsVisible="{Binding Main.ShowRequests}" RowDefinitions="Auto,Auto,*">
            <Grid IsVisible="{Binding ShowContext}" ColumnDefinitions="*,Auto" Margin="10,8,10,0"><ComboBox ItemsSource="{Binding Main.Environments}" SelectedItem="{Binding Main.SelectedEnvironment}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="m:EnvironmentDefinition"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Grid.Column="1" Content="变量" Classes="ghost" Command="{Binding Main.ManageEnvironmentsCommand}" /></Grid>
            <Grid IsVisible="{Binding ShowContext}" Grid.Row="1" ColumnDefinitions="*,Auto" Margin="10,6"><ComboBox ItemsSource="{Binding Main.Tabs}" SelectedItem="{Binding Main.SelectedTab}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="tabs:RequestTabViewModel"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Grid.Column="1" Content="×" Classes="ghost" Command="{Binding Main.SelectedTab.CloseCommand}" /></Grid>
            <mobile:MobileRequestView Grid.Row="2" DataContext="{Binding Main.SelectedTab}" />
          </Grid>
          <StackPanel IsVisible="{Binding Main.ShowEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" Margin="24"><TextBlock Text="从一个请求开始" FontSize="22" FontWeight="SemiBold" /><Button Content="＋ HTTP 请求" Classes="primary" Command="{Binding NewHttpCommand}" /><Button Content="导入请求" Command="{Binding Main.ImportCommand}" /></StackPanel>
          <Border IsVisible="{Binding Main.IsTools}"><tools:ToolsView DataContext="{Binding Main.Tools}" /></Border>
        </Grid>
        <Border IsVisible="{Binding ShowShade}" Background="#88000000" Tapped="CloseDrawer" />
        <Border x:Name="NavigationPanel" IsVisible="{Binding SidebarVisible}" Width="{Binding SidebarWidth}" HorizontalAlignment="Left" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid RowDefinitions="Auto,Auto,*,Auto" Height="{Binding #NavigationPanel.Bounds.Height}" MinHeight="600">
            <UniformGrid Columns="4" Margin="6"><Button Content="集合" Classes="ghost" Command="{Binding NavigateCommand}" CommandParameter="工作区" /><Button Content="历史" Classes="ghost" Command="{Binding NavigateCommand}" CommandParameter="历史记录" /><Button Content="抓包" Classes="ghost" Command="{Binding NavigateCommand}" CommandParameter="代理抓包" /><Button Content="工具" Classes="ghost" Command="{Binding NavigateCommand}" CommandParameter="工具" /></UniformGrid>
            <Expander Grid.Row="1" Header="请求与环境" Margin="8" IsVisible="{Binding IsShort}"><StackPanel Spacing="6"><ComboBox ItemsSource="{Binding Main.Tabs}" SelectedItem="{Binding Main.SelectedTab}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="tabs:RequestTabViewModel"><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><ComboBox ItemsSource="{Binding Main.Environments}" SelectedItem="{Binding Main.SelectedEnvironment}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="m:EnvironmentDefinition"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Content="管理变量" Command="{Binding Main.ManageEnvironmentsCommand}" /></StackPanel></Expander>
            <Grid Grid.Row="2" DataContext="{Binding Main}"><workspace:WorkspaceExplorerView IsVisible="{Binding IsWorkspace}" /><history:HistoryPanelView IsVisible="{Binding IsHistory}" /><capture:CapturePanelView IsVisible="{Binding IsCapture}" /><ListBox ItemsSource="{Binding Tools.Kinds}" SelectedItem="{Binding Tools.SelectedTool}" IsVisible="{Binding IsTools}" Background="Transparent" Margin="12" /></Grid>
            <WrapPanel Grid.Row="3" Margin="8"><Button Content="设置" Classes="ghost" Command="{Binding Main.SettingsCommand}" /><Button Content="检查更新" Classes="ghost" Command="{Binding Main.CheckUpdatesCommand}" /><Button Content="目录操作" Classes="ghost"><Button.Flyout><MenuFlyout><MenuItem Header="重命名" Command="{Binding Main.RenameCommand}" /><MenuItem Header="删除选中项" Command="{Binding Main.DeleteCommand}" /><MenuItem Header="导入到选中文件夹" Command="{Binding Main.ImportCommand}" /><MenuItem Header="刷新导入源" Command="{Binding Main.RefreshImportCommand}" /><MenuItem Header="导出 OpenAPI" Command="{Binding Main.ExportCommand}" /></MenuFlyout></Button.Flyout></Button></WrapPanel>
          </Grid>
          </ScrollViewer>
        </Border>
      </Panel>
      <Border Grid.Row="2" Background="{DynamicResource RaisedBackgroundBrush}" Padding="12,6"><Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Main.Status}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" /><Button Grid.Column="1" Content="安装更新" Classes="ghost" IsVisible="{Binding Main.UpdateReady}" Command="{Binding Main.ShowUpdatePromptCommand}" Padding="6,0" /><TextBlock Grid.Row="1" Text="{Binding Main.UpdateStatus}" IsVisible="{Binding Main.HasUpdateStatus}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" /></Grid></Border>
    </Grid>
    <mobile:MobileDialogHost x:Name="Dialogs" />
  </Panel>
</UserControl>
