<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ApiNet.Desktop.ViewModels.Tabs" xmlns:c="using:ApiNet.Desktop.Controls" xmlns:views="using:ApiNet.Desktop.Views.Tabs" x:Class="ApiNet.Desktop.Views.Mobile.MobileRequestView" x:DataType="vm:RequestTabViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="8,0,8,8">
    <Grid x:Name="NameRow" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4"><TextBox x:Name="NameInput" Text="{Binding Name}" FontWeight="SemiBold" /><Button Grid.Column="1" Classes="ghost" Content="复制" Command="{Binding DuplicateCommand}" /><Button Grid.Column="2" Content="保存" Command="{Binding SaveCommand}" /></Grid>
    <c:CodeEditor Grid.Row="1" Text="{Binding Url}" SingleLine="True" MinHeight="48" Margin="0,8" />
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8"><ComboBox ItemsSource="{Binding MethodOptions}" SelectedItem="{Binding Method}" MinWidth="90" /><Button Grid.Column="1" Content="预览变量" Classes="ghost" Command="{Binding PreviewCommand}" HorizontalAlignment="Left" /><ContentControl Grid.Column="2" Content="{Binding}"><ContentControl.DataTemplates><DataTemplate DataType="vm:HttpRequestTabViewModel" x:DataType="vm:HttpRequestTabViewModel"><StackPanel Orientation="Horizontal" Spacing="4"><Button Classes="primary" Content="{Binding SendLabel}" Command="{Binding SendCommand}" /><Button Content="取消" Classes="ghost" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" /></StackPanel></DataTemplate><DataTemplate DataType="vm:WebSocketTabViewModel" x:DataType="vm:WebSocketTabViewModel"><StackPanel Orientation="Horizontal" Spacing="4"><Button Content="连接" Classes="primary" Command="{Binding ConnectCommand}" /><Button Content="断开" Command="{Binding DisconnectCommand}" /></StackPanel></DataTemplate></ContentControl.DataTemplates></ContentControl></Grid>
    <ProgressBar Grid.Row="1" Height="2" VerticalAlignment="Bottom" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
    <ContentControl Grid.Row="3" Content="{Binding}"><ContentControl.DataTemplates>
      <DataTemplate DataType="vm:HttpRequestTabViewModel" x:DataType="vm:HttpRequestTabViewModel"><TabControl SelectedIndex="{Binding MobileSection}">

          <TabItem Header="Params"><c:ParameterTable Rows="{Binding QueryRows}" AddCommand="{Binding AddQueryCommand}" MinTableWidth="320" /></TabItem>
          <TabItem Header="Headers"><c:ParameterTable Rows="{Binding HeaderRows}" AddCommand="{Binding AddHeaderCommand}" MinTableWidth="320" /></TabItem>
          <TabItem Header="Body"><Grid RowDefinitions="Auto,*"><Grid ColumnDefinitions="*,Auto" Margin="0,6"><ComboBox ItemsSource="{Binding BodyFormats}" SelectedItem="{Binding BodyFormat}" HorizontalAlignment="Stretch" /><Button Grid.Column="1" Content="格式化" Classes="ghost" Command="{Binding FormatBodyCommand}" IsVisible="{Binding IsRawBody}" /></Grid><c:CodeEditor Grid.Row="1" Text="{Binding Body}" Language="{Binding BodyFormat}" IsVisible="{Binding IsRawBody}" /><c:ParameterTable Grid.Row="1" Rows="{Binding BodyRows}" AddCommand="{Binding AddBodyParameterCommand}" AllowFiles="{Binding IsMultipartBody}" MinTableWidth="560" IsVisible="{Binding IsFormBody}" /></Grid></TabItem>
          <TabItem Header="认证"><StackPanel Spacing="12" Margin="8"><CheckBox IsChecked="{Binding FollowRedirects}" Content="自动跟随重定向" /><TextBlock Text="Bearer Token" /><c:CodeEditor Text="{Binding BearerToken}" SingleLine="True" /><TextBlock Text="支持 {{token}} 环境变量" Foreground="{DynamicResource TextMutedBrush}" /></StackPanel></TabItem>
        <TabItem Header="响应"><Grid RowDefinitions="Auto,*"><StackPanel Margin="8" Spacing="8"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource SuccessBrush}" /><TextBlock Text="{Binding ResolvedUrl}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" /><Button Content="保存响应" Command="{Binding SaveResponseCommand}" IsEnabled="{Binding CanSaveResponse}" HorizontalAlignment="Left" /></StackPanel><TabControl Grid.Row="1"><TabItem Header="Body"><c:CodeEditor Text="{Binding ResponseBody, Mode=OneWay}" Language="{Binding ResponseFormat}" IsReadOnly="True" /></TabItem><TabItem Header="Headers"><c:CodeEditor Text="{Binding ResponseHeaders, Mode=OneWay}" IsReadOnly="True" /></TabItem></TabControl></Grid></TabItem>
      </TabControl></DataTemplate>
      <DataTemplate DataType="vm:WebSocketTabViewModel" x:DataType="vm:WebSocketTabViewModel"><views:WebSocketView /></DataTemplate>
    </ContentControl.DataTemplates></ContentControl>
  </Grid>
</UserControl>
