<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ApiNet.Desktop.ViewModels.Settings" x:Class="ApiNet.Desktop.Views.Mobile.MobileSettingsView" x:DataType="vm:SettingsViewModel">
  <StackPanel Spacing="14"><TextBlock Text="外观主题" /><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" HorizontalAlignment="Stretch" /><TextBlock Text="代理监听端口" /><TextBox Text="{Binding ProxyPort}" /><CheckBox IsChecked="{Binding DecryptHttps}" Content="启用 HTTPS 解密" /><TextBlock Text="使用显式 HTTP 代理，保持应用在前台。HTTPS 解密需客户端信任证书；不提供 VPN 全局抓包。" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" /><CheckBox IsChecked="{Binding AutoCheckUpdates}" Content="检查并下载 GitHub 新版本" /><TextBlock Text="Android 系统会要求确认 APK 安装。" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" /><TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" /><Button Classes="primary" Content="保存设置" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" /></StackPanel>
</UserControl>
