<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ApiNet.Desktop.ViewModels.Settings"
        x:Class="ApiNet.Desktop.Views.Settings.SettingsWindow" x:DataType="vm:SettingsViewModel"
        Title="设置" Width="650" SizeToContent="Height" WindowStartupLocation="CenterOwner" CanResize="False" Background="{DynamicResource SurfaceBackgroundBrush}">
  <StackPanel Margin="28" Spacing="16">
    <TextBlock Text="应用设置" FontSize="22" FontWeight="SemiBold" />
    <Grid ColumnDefinitions="120,*"><TextBlock Text="外观主题" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" HorizontalAlignment="Stretch" /></Grid>
    <TextBlock Text="窗口行为" Foreground="{DynamicResource AccentTextBrush}" Margin="0,8,0,0" />
    <CheckBox IsChecked="{Binding CloseToTray}" Content="关闭窗口时隐藏到系统托盘，保持后台运行" />
    <TextBlock Text="未勾选时，关闭窗口将退出应用。退出时保留编辑草稿。" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
    <TextBlock Text="代理抓包" Foreground="{DynamicResource AccentTextBrush}" Margin="0,8,0,0" />
    <Grid ColumnDefinitions="120,*"><TextBlock Text="监听端口" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding ProxyPort}" /></Grid>
    <CheckBox IsChecked="{Binding DecryptHttps}" Content="启用 HTTPS 解密（客户端需信任本地 CA）" />
    <TextBlock Text="代理绑定 127.0.0.1；修改配置后重新启动代理生效。" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
    <TextBlock Text="在线更新" Foreground="{DynamicResource AccentTextBrush}" Margin="0,8,0,0" />
    <TextBlock Text="通过 ApiNet 的 GitHub Releases 自动提供更新，无需配置地址。" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" />
    <CheckBox IsChecked="{Binding AutoCheckUpdates}" Content="启动及后台定期检查更新，发现新版本后自动下载" />
    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
    <Button Classes="primary" Content="保存设置" Command="{Binding SaveCommand}" HorizontalAlignment="Right" />
  </StackPanel>
</Window>
