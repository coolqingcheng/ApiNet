<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ApiNet.Desktop.ViewModels.Tabs" xmlns:local="using:ApiNet.Desktop.Views.Tabs"
             xmlns:c="using:ApiNet.Desktop.Controls" x:Class="ApiNet.Desktop.Views.Tabs.RequestTabView" x:DataType="vm:RequestTabViewModel">
  <UserControl.Styles>
    <Style Selector="Path.send-spinner[IsVisible=True]">
      <Style.Animations>
        <Animation Duration="0:0:0.8" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <Grid ColumnDefinitions="*,Auto,Auto" Margin="20,16,20,12"><TextBox x:Name="RequestName" Text="{Binding Name}" Background="{DynamicResource WindowBackgroundBrush}" BorderThickness="1" FontSize="17" FontWeight="SemiBold" Padding="12,7" /><Button Grid.Column="1" Content="复制" Classes="ghost" Command="{Binding DuplicateCommand}" /><Button Grid.Column="2" Content="保存" Classes="ghost" Command="{Binding SaveCommand}" ToolTip.Tip="Ctrl+S" /></Grid>
    <Grid Grid.Row="1" ColumnDefinitions="100,*,Auto" Margin="20,0,20,8" ColumnSpacing="8">
      <ComboBox ItemsSource="{Binding MethodOptions}" SelectedItem="{Binding Method}" IsVisible="{Binding IsHttp}" HorizontalAlignment="Stretch" />
      <Border IsVisible="{Binding IsWebSocket}" Background="{DynamicResource PurpleSurfaceBrush}" CornerRadius="5"><TextBlock Text="WS" Foreground="{DynamicResource PurpleBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
      <c:CodeEditor Grid.Column="1" Text="{Binding Url}" SingleLine="True" MinHeight="36" />
      <ContentControl Grid.Column="2" Content="{Binding}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="{x:Type vm:HttpRequestTabViewModel}" x:DataType="vm:HttpRequestTabViewModel"><StackPanel Orientation="Horizontal" Spacing="6"><Button Classes="primary" Command="{Binding SendCommand}" MinWidth="100"><StackPanel Orientation="Horizontal" Spacing="8"><Path x:Name="SendLoading" Classes="send-spinner" IsVisible="{Binding IsBusy}" Data="M 8,1 A 7,7 0 1 1 1,8" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" Stretch="Uniform" Width="14" Height="14" RenderTransformOrigin="50%,50%" VerticalAlignment="Center" /><TextBlock Text="{Binding SendLabel}" VerticalAlignment="Center" /></StackPanel></Button><Button Content="取消" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" /></StackPanel></DataTemplate>
          <DataTemplate DataType="{x:Type vm:WebSocketTabViewModel}" x:DataType="vm:WebSocketTabViewModel"><StackPanel Orientation="Horizontal" Spacing="6"><Button Content="连接" Classes="primary" Command="{Binding ConnectCommand}" /><Button Content="断开" Command="{Binding DisconnectCommand}" /></StackPanel></DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="20,0,20,10"><Button Content="预览变量" Classes="ghost" Command="{Binding PreviewCommand}" FontSize="11" Padding="0,5,10,5" /><TextBlock Grid.Column="1" Text="{Binding ResolvedUrl}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></Grid>
    <ContentControl Grid.Row="3" Content="{Binding}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="{x:Type vm:HttpRequestTabViewModel}" x:DataType="vm:HttpRequestTabViewModel"><local:HttpRequestView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WebSocketTabViewModel}" x:DataType="vm:WebSocketTabViewModel"><local:WebSocketView /></DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
  </Grid>
</UserControl>
