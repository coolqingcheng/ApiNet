<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ApiNet.Desktop.ViewModels.Tools"
             x:Class="ApiNet.Desktop.Views.Tools.CronToolView" x:DataType="vm:CronToolViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="18" MaxWidth="900" HorizontalAlignment="Stretch">
      <WrapPanel>
        <StackPanel Spacing="6" Margin="0,0,18,8"><TextBlock Text="表达式格式" Foreground="{DynamicResource TextMutedBrush}" /><ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}" MinWidth="240" /></StackPanel>
        <StackPanel Spacing="6" Margin="0,0,0,8"><TextBlock Text="执行时区" Foreground="{DynamicResource TextMutedBrush}" /><ComboBox ItemsSource="{Binding Zones}" SelectedItem="{Binding Zone}" Width="160" /></StackPanel>
      </WrapPanel>
      <Border Background="{DynamicResource RaisedBackgroundBrush}" CornerRadius="6" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="解析表达式" FontWeight="SemiBold" />
          <TextBox x:Name="CronExpressionInput" Text="{Binding Expression}" Watermark="例如 */5 * * * *" FontFamily="Cascadia Code, Consolas, Menlo, monospace" />
          <WrapPanel><Button Content="解析 / 刷新执行时间" Classes="primary" Command="{Binding ParseCommand}" Margin="0,0,8,4" /><Button Content="复制表达式" Classes="ghost" Tag="expression" Click="CopyResult" Margin="0,0,0,4" /></WrapPanel>
          <TextBlock Text="支持 *、,、-、/、L、W、# 和英文月份 / 星期缩写。周日为 0 或 7；日和周同时指定时需同时满足。不含年份。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
      </Border>
      <Border Background="{DynamicResource RaisedBackgroundBrush}" CornerRadius="6" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="生成表达式" FontWeight="SemiBold" />
          <WrapPanel><ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}" MinWidth="210" Margin="0,0,12,8" /><Button Content="套用模板" Command="{Binding ApplyPresetCommand}" Margin="0,0,0,8" /></WrapPanel>
          <WrapPanel>
            <StackPanel Spacing="6" Margin="0,0,12,8" IsVisible="{Binding IncludeSeconds}"><TextBlock Text="秒（0–59）" FontSize="12" /><TextBox Text="{Binding Second}" Width="115" /></StackPanel>
            <StackPanel Spacing="6" Margin="0,0,12,8"><TextBlock Text="分（0–59）" FontSize="12" /><TextBox Text="{Binding Minute}" Width="115" /></StackPanel>
            <StackPanel Spacing="6" Margin="0,0,12,8"><TextBlock Text="时（0–23）" FontSize="12" /><TextBox Text="{Binding Hour}" Width="115" /></StackPanel>
            <StackPanel Spacing="6" Margin="0,0,12,8"><TextBlock Text="日（1–31）" FontSize="12" /><TextBox Text="{Binding Day}" Width="115" /></StackPanel>
            <StackPanel Spacing="6" Margin="0,0,12,8"><TextBlock Text="月（1–12）" FontSize="12" /><TextBox Text="{Binding Month}" Width="115" /></StackPanel>
            <StackPanel Spacing="6" Margin="0,0,0,8"><TextBlock Text="周（0–7）" FontSize="12" /><TextBox Text="{Binding Week}" Width="115" /></StackPanel>
          </WrapPanel>
          <Button Content="生成并解析" Command="{Binding GenerateCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="解析结果与执行预览" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Grid.Column="1" Content="复制结果" Classes="ghost" Click="CopyResult" /></Grid>
        <SelectableTextBlock x:Name="CronResult" Text="{Binding Result}" TextWrapping="Wrap" FontFamily="Cascadia Code, Consolas, Menlo, monospace" LineHeight="24" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
