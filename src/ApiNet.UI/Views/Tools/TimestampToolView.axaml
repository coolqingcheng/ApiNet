<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ApiNet.Desktop.ViewModels.Tools"
             x:Class="ApiNet.Desktop.Views.Tools.TimestampToolView" x:DataType="vm:TimestampToolViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="18" MaxWidth="900" HorizontalAlignment="Stretch">
      <WrapPanel>
        <StackPanel Spacing="6" Margin="0,0,18,8"><TextBlock Text="时间戳单位" Foreground="{DynamicResource TextMutedBrush}" /><ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}" Width="140" /></StackPanel>
        <StackPanel Spacing="6" Margin="0,0,18,8"><TextBlock Text="日期时区" Foreground="{DynamicResource TextMutedBrush}" /><ComboBox ItemsSource="{Binding Zones}" SelectedItem="{Binding Zone}" Width="160" /></StackPanel>
        <Button Content="当前时间" Classes="ghost" Command="{Binding NowCommand}" VerticalAlignment="Bottom" Margin="0,0,0,8" />
      </WrapPanel>
      <Border Background="{DynamicResource RaisedBackgroundBrush}" CornerRadius="6" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="时间戳 → 日期" FontWeight="SemiBold" />
          <TextBox x:Name="TimestampInput" Text="{Binding Timestamp}" Watermark="输入整数时间戳" />
          <Button Content="转为日期" Classes="primary" Command="{Binding ToDateCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
      <Border Background="{DynamicResource RaisedBackgroundBrush}" CornerRadius="6" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="日期 → 时间戳" FontWeight="SemiBold" />
          <TextBox x:Name="DateInput" Text="{Binding Date}" Watermark="yyyy-MM-dd HH:mm:ss.fff，或 ISO 8601 日期" />
          <TextBlock Text="无偏移时使用所选时区；带 Z 或 +08:00 等偏移时使用日期自身的偏移。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
          <Button Content="转为时间戳" Classes="primary" Command="{Binding ToTimestampCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="转换结果" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Grid.Column="1" Content="复制结果" Classes="ghost" Click="CopyResult" /></Grid>
        <SelectableTextBlock Text="{Binding Result}" TextWrapping="Wrap" FontFamily="Cascadia Code, Consolas, Menlo, monospace" LineHeight="26" />
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
