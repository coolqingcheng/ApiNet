<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ApiNet.Desktop.ViewModels.Tools" xmlns:c="using:ApiNet.Desktop.Controls"
             x:Class="ApiNet.Desktop.Views.Tools.ToolsView" x:DataType="vm:ToolsViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24,20">
    <StackPanel Spacing="10" Margin="0,0,0,18">
      <TextBlock Text="{Binding SelectedTool}" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
      <WrapPanel Margin="0,6,0,0">
        <Button Margin="0,0,8,8" Content="格式化" Classes="primary" Command="{Binding TransformCommand}" CommandParameter="format" IsVisible="{Binding IsJson}" />
        <Button Margin="0,0,8,8" Content="压缩" Command="{Binding TransformCommand}" CommandParameter="minify" IsVisible="{Binding IsJson}" />
        <Button Margin="0,0,8,8" Content="编码" Classes="primary" Command="{Binding TransformCommand}" CommandParameter="encode" IsVisible="{Binding IsCodec}" />
        <Button Margin="0,0,8,8" Content="解码" Command="{Binding TransformCommand}" CommandParameter="decode" IsVisible="{Binding IsCodec}" />
        <Button Margin="0,0,8,8" Content="结果填回输入" Classes="ghost" Command="{Binding UseOutputCommand}" />
        <Button Margin="0,0,8,8" Content="清空" Classes="ghost" Command="{Binding ClearCommand}" />
      </WrapPanel>
    </StackPanel>
    <Grid x:Name="EditorPanels" Grid.Row="1" ColumnDefinitions="*,12,*">
      <Grid x:Name="InputPanel" RowDefinitions="Auto,*"><TextBlock Text="输入" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10" /><Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"><c:CodeEditor Text="{Binding Input}" Language="{Binding Language}" /></Border></Grid>
      <Grid x:Name="OutputPanel" Grid.Column="2" RowDefinitions="Auto,*"><Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10"><TextBlock Text="结果" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="复制结果" Classes="ghost" Padding="6,0" Click="CopyOutput" /></Grid><Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"><c:CodeEditor Text="{Binding Output, Mode=OneWay}" Language="{Binding Language}" IsReadOnly="True" /></Border></Grid>
    </Grid>
    <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,14,0,0" />
  </Grid>
</UserControl>
