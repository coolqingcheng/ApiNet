<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ApiNet.Desktop.ViewModels" xmlns:node="using:ApiNet.Desktop.ViewModels.Workspace" xmlns:c="using:ApiNet.Desktop.Controls"
             x:Class="ApiNet.Desktop.Views.Workspace.WorkspaceExplorerView" x:DataType="vm:MainWindowViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
    <Grid ColumnDefinitions="*,Auto" Margin="16,18,10,12"><TextBlock Text="请求集合" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Grid.Column="1" Classes="ghost" Content="＋ 文件夹" Command="{Binding NewFolderCommand}" /></Grid>
    <TextBox Grid.Row="1" Text="{Binding Search}" Watermark="搜索名称、路径或方法" Margin="12,0,12,12" />
    <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="12,0,12,10" ColumnSpacing="8"><Button Content="＋ HTTP" Command="{Binding NewHttpCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" /><Button Grid.Column="1" Content="＋ WebSocket" Command="{Binding NewSocketCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" /></Grid>
    <TreeView Grid.Row="3" x:Name="RequestTree" ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}" SelectionMode="Multiple" Background="Transparent" Margin="5,0" SelectionChanged="OnSelectionChanged" DragDrop.AllowDrop="True">
      <TreeView.Styles><Style Selector="TreeViewItem" x:DataType="node:WorkspaceNodeViewModel"><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" /><Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" /></Style></TreeView.Styles>
      <TreeView.ItemTemplate><TreeDataTemplate x:DataType="node:WorkspaceNodeViewModel" ItemsSource="{Binding Children}"><Grid ColumnDefinitions="38,*,Auto" ColumnSpacing="4"><TextBlock Text="{Binding Badge}" IsVisible="{Binding !IsFolder}" Foreground="{Binding BadgeColor}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" /><c:NavigationIcon Kind="Folder" Width="16" Height="16" IsVisible="{Binding IsFolder}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><TextBlock Grid.Column="2" IsVisible="{Binding SourceRemoved}" Text="!" Foreground="{DynamicResource WarningBrush}" ToolTip.Tip="接口已从导入文档中移除，本地仍保留" /></Grid></TreeDataTemplate></TreeView.ItemTemplate>
      <TreeView.ContextMenu><ContextMenu><MenuItem Header="新建文件夹" Command="{Binding NewFolderCommand}" /><MenuItem Header="新建 HTTP 请求" Command="{Binding NewHttpCommand}" /><MenuItem Header="新建 WebSocket" Command="{Binding NewSocketCommand}" /><Separator /><MenuItem Header="重命名" Command="{Binding RenameCommand}" /><MenuItem Header="删除" Command="{Binding DeleteCommand}" /><Separator /><MenuItem Header="导入到此文件夹" Command="{Binding ImportCommand}" /><MenuItem Header="增量更新导入源" Command="{Binding RefreshImportCommand}" /><MenuItem Header="导出文档（MD / PDF / JSON）" Command="{Binding ExportCommand}" /></ContextMenu></TreeView.ContextMenu>
    </TreeView>
    <Border Grid.Row="4" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="8"><StackPanel Spacing="4"><TextBlock Text="{Binding WorkspaceSelectionSummary}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="4,0" /><StackPanel Orientation="Horizontal" Spacing="4"><Button Classes="ghost" Content="导入" Command="{Binding ImportCommand}" /><Button Classes="ghost" Content="导出文档" Command="{Binding ExportCommand}" /><Button Classes="ghost" Content="更新源" Command="{Binding RefreshImportCommand}" /></StackPanel><StackPanel Orientation="Horizontal"><Button Classes="ghost" Content="工作区根目录" Command="{Binding SelectRootCommand}" FontSize="11" /><Button Classes="ghost" Content="清空选择" Command="{Binding ClearWorkspaceSelectionCommand}" IsVisible="{Binding HasWorkspaceSelection}" FontSize="11" /></StackPanel></StackPanel></Border>
  </Grid>
</UserControl>
