<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>../PostNet.UI/Assets/app.ico</ApplicationIcon>
    <AssemblyName>PostNet.Setup</AssemblyName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/WindowsShell*.cs" Link="Services/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../PostNet.UI/Assets/app.ico" LogicalName="PostNet.ShellIcon.ico" />
    <ProjectReference Include="../PostNet.Core/PostNet.Core.csproj" />
    <EmbeddedResource Include="$(InstallerPayload)" LogicalName="PostNet.Setup.Payload.exe" Condition="'$(InstallerPayload)' != ''" />
  </ItemGroup>
  <Target Name="ValidateInstallerPayload" BeforeTargets="Publish" Condition="'$(InstallerPayload)' == '' Or !Exists('$(InstallerPayload)')">
    <Error Text="发布安装器必须通过 InstallerPayload 指定 Velopack Setup.exe。" />
  </Target>
</Project>
