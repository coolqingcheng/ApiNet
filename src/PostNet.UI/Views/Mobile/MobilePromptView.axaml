<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:PostNet.Desktop.ViewModels.Dialogs" x:Class="PostNet.Desktop.Views.Mobile.MobilePromptView" x:DataType="vm:DialogViewModel">
  <StackPanel Spacing="16"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBox Text="{Binding Value}" IsVisible="{Binding ShowInput}" TextWrapping="Wrap" /><ItemsControl ItemsSource="{Binding Choices}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:DialogChoice"><Button Content="{Binding Label}" Command="{Binding Command}" Margin="0,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
</UserControl>
